# StudyCollab API – required and optional env vars
# Copy to .env and set values. Never commit .env.

NODE_ENV=development
PORT=3001

# Required (use strong secrets in production)
DATABASE_URL=postgresql://studycollab:studycollab@localhost:5432/studycollab
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key

# CORS and frontend
FRONTEND_URL=http://localhost:3000

# Optional – Redis (notifications, CSRF). If unset, CSRF disabled via DISABLE_CSRF.
REDIS_URL=redis://localhost:6379

# Optional – disable security features (dev/test only)
# DISABLE_CSRF=true
# DISABLE_RATE_LIMIT=true
# DISABLE_INPUT_SANITIZATION=true

# Optional – demo mode, logging
# DEMO_MODE=true
# LOG_LEVEL=debug
# LOG_TO_FILE=true

# Test-only (vitest, E2E)
# TEST_DATABASE_URL=postgresql://...
